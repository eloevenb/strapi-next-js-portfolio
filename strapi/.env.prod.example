# Server
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://api.example.com
# Must be true when Strapi is behind a reverse proxy (Caddy, nginx, Traefik, etc.)
# so it trusts X-Forwarded-Proto and can set secure cookies.
IS_PROXIED=true

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=strapiDB
DATABASE_PORT=5432
DATABASE_NAME=portfolio_prod
DATABASE_USERNAME=portfolio_user
DATABASE_PASSWORD=change_this_password
DATABASE_SSL=false
DATABASE_SCHEMA=public
DATABASE_CONNECTION_TIMEOUT=60000

# Secrets
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=change_this_salt
ADMIN_JWT_SECRET=change_this_secret
TRANSFER_TOKEN_SALT=change_this_salt
JWT_SECRET=change_this_secret
ENCRYPTION_KEY=change_this_key

# Application
CLIENT_URL=https://www.example.com
PREVIEW_SECRET=change_this_preview_secret

# Environment
NODE_ENV=production
