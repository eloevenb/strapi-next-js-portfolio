STRAPI_API_URL=https://api.example.com/api
# Public Strapi origin. next/image allows this host only, under /uploads/.
# For this site set https://strapi.eloevenb.fr here and in the compose build env.
# Rebuild the frontend image after changing it; the build arg and this runtime
# value must be the same host.
NEXT_PUBLIC_STRAPI_URL=https://strapi.example.com
# Leave unset in production so the optimizer fetches the public https origin.
# Set to http://strapi:1337 only if the frontend container cannot reach that
# public origin. That path also allows private-IP fetches for this host.
# NEXT_PUBLIC_STRAPI_IMAGE_URL=http://strapi:1337
STRAPI_READ_ONLY_TOKEN=your_read_only_token_here
REVALIDATE_SECRET=your_revalidate_secret_here
