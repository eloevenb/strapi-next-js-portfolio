# Compose production configuration
COMPOSE_PROJECT_NAME=portfolio-prod

STRAPI_CONTAINER_NAME=strapi
STRAPI_IMAGE=portfolio-strapi:latest
STRAPI_HOST_PORT=1337
STRAPI_PORT=1337

DATABASE_CONTAINER_NAME=strapiDB
DATABASE_PLATFORM=linux/amd64
DATABASE_IMAGE=postgres:16.0-alpine
DATABASE_NAME=portfolio_prod
DATABASE_USERNAME=portfolio_user
DATABASE_PASSWORD=change_this_password

FRONTEND_CONTAINER_NAME=frontend
FRONTEND_IMAGE=portfolio-frontend:latest
FRONTEND_HOST_PORT=3000
FRONTEND_PORT=3000

NETWORK_NAME=portfolio-prod
NETWORK_DRIVER=bridge
DATABASE_VOLUME_NAME=portfolio-prod-strapi-data

# Frontend production build args (also set in frontend/.env.prod).
# NEXT_PUBLIC_STRAPI_URL is the public Strapi origin (https://strapi.eloevenb.fr).
# It is baked into image URLs and is the host next/image is allowed to optimize.
STRAPI_API_URL=http://strapi:1337/api
NEXT_PUBLIC_STRAPI_URL=https://strapi.example.com
# Public origin baked into canonical URLs, sitemap.xml, and robots.txt
SITE_URL=https://example.com
