# Compose development configuration.
COMPOSE_PROJECT_NAME=portfolio-dev

STRAPI_CONTAINER_NAME=strapi-dev
STRAPI_IMAGE=strapi:dev
STRAPI_HOST_PORT=1337
STRAPI_PORT=1337

DATABASE_CONTAINER_NAME=strapiDB-dev
DATABASE_PLATFORM=linux/amd64
DATABASE_IMAGE=postgres:16.0-alpine
DATABASE_HOST_PORT=5432
DATABASE_PORT=5432
DATABASE_NAME=portfolio_dev
DATABASE_USERNAME=portfolio_user
DATABASE_PASSWORD=change_this_password

FRONTEND_CONTAINER_NAME=frontend-dev
FRONTEND_IMAGE=frontend:dev
FRONTEND_HOST_PORT=3000
FRONTEND_PORT=3000
FRONTEND_SECURITY_OPT=seccomp:unconfined

NETWORK_NAME=portfolio-dev
NETWORK_DRIVER=bridge
DATABASE_VOLUME_NAME=portfolio-dev-strapi-data
